# =============================================================================
# Production env file for the EC2 container.
#
# Copy this to  ~/evidence-monitoring-agent/.env  ON THE EC2 HOST (not in git)
# and fill in real values. ec2_deploy.sh passes it to `docker run --env-file`.
#
# NOTE: the deploy intentionally never rsyncs or bakes a .env into the image,
# so this file lives only on the server.
# =============================================================================

# ===== AWS Credentials (required for Bedrock) =====
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_REGION=us-east-2

# ===== Database =====
# Absolute path INSIDE the container. ec2_deploy.sh mounts the host's
# ./data directory to /app/data, so the SQLite file survives redeploys.
# (Four slashes = absolute path for the sqlite+aiosqlite URL.)
DATABASE_URL=sqlite+aiosqlite:////app/data/evidence_monitoring.db

# ===== Bedrock Model IDs (us-east-2 inference profiles) =====
TARGET_CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
TARGET_NOVA_MODEL_ID=us.amazon.nova-2-lite-v1:0
TARGET_LLAMA_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
ORCHESTRATOR_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SCORING_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ===== Anthropic (Claude target — direct API with web-search citations) =====
# Leave BLANK to keep the monitored `claude` target on Bedrock (above). Set ANTHROPIC_API_KEY
# to auto-switch `claude` to the direct Anthropic API (api.anthropic.com) with the native
# web_search tool -> real source citations like Gemini/GPT-4o. Requires the `anthropic` package
# (already in requirements.txt) -> REBUILD the image. Orchestrator + scoring stay on Bedrock.
ANTHROPIC_API_KEY=
TARGET_CLAUDE_ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929

# ===== Discovery harvester (Tavily web search) =====
# Required for the Discovery feature (/discovery). WITHOUT this key the backend
# reports configured:false and the Discovery page shows a "Tavily API key not set"
# banner with the Harvest button disabled. The harvester is Tavily-only.
TAVILY_API_KEY=your-tavily-key-here

# ===== Run Configuration =====
# Hard token ceiling for ONE run; the run stops with status PAUSED_BUDGET when it is hit
# (and is resumable from the UI afterwards). 0 disables the guard entirely.
#
# SIZE THIS DELIBERATELY. A full 823-question bank run costs roughly 8,500 tokens per
# response across ~5,300 responses, i.e. ~37M tokens, so a ceiling set far above that is
# the same as having no cost circuit-breaker at all. The value below stops a full-bank run
# about a third of the way in; raise it if you intend to complete one in a single pass.
MAX_TOKENS_PER_RUN=500000
# Marker file scripts/ec2_deploy.sh writes while a deploy is staging; the backend refuses
# to START runs while it exists, because the container swap at the end of a deploy kills
# anything in flight. Leave BLANK: it then resolves to the directory holding the SQLite
# file above (/app/data), which is exactly the host dir the deploy script writes to.
DEPLOY_LOCK_PATH=
# Per-call timeout (seconds) for a single target LLM request. Bounds a hung provider
# (stalled socket) so it becomes a FAILED response instead of freezing the whole run.
TARGET_CALL_TIMEOUT_SECONDS=120
# Daily scheduled-run cadence, evaluated in SCHEDULE_TIMEZONE (DST-aware).
# Default = midnight Dallas time. The schedule is OFF by default; toggle it in the UI.
DEFAULT_SCHEDULE_CRON=0 0 * * *
SCHEDULE_TIMEZONE=America/Chicago

# ===== BR-008a Stakeholder-Differentiated Digests =====
# Weekly, role-specific intelligence digests (PV / Brand / Medical Affairs). Digests are
# ALWAYS generated and stored in-app; EMAIL delivery is opt-in via AWS SES.
DIGEST_ENABLED=true
DIGEST_SCHEDULER_ENABLED=true
# Days of alerts each weekly digest covers.
DIGEST_LOOKBACK_DAYS=7
#
# ---- Email delivery via AWS SES (opt-in) — PRODUCTION ENABLE CHECKLIST ----
# By default email is OFF (safe no-op): digests still generate + store in-app. To deliver
# REAL email in prod, complete ALL of these, then restart the backend:
#   1) SES_ENABLED=true
#   2) SES_SENDER = an SES-VERIFIED identity (email address or domain) in this AWS account.
#   3) SES_REGION = the region where SES is set up (blank falls back to AWS_REGION).
#   4) IAM: AWS_ACCESS_KEY_ID/SECRET need `ses:SendRawEmail` (delivery). To also see the
#      readiness banner state, add `ses:GetIdentityVerificationAttributes`,
#      `ses:GetSendQuota`, `ses:ListVerifiedEmailAddresses` (optional — missing = "unknown").
#   5) SANDBOX: if the SES account is still in sandbox, EVERY recipient address must ALSO be
#      verified in SES. Request production access to email arbitrary recipients.
#   6) VERIFY: GET /digests/ses-check (or the banner on the Stakeholder Digests page) — it
#      reports enabled/sender/sandbox/verification and an actionable reason when not ready.
SES_ENABLED=false
SES_SENDER=
SES_REGION=
# Where generated PDF artifacts are written (blank = <project_root>/data/digests).
DIGEST_OUTPUT_DIR=

# ===== EvidenceMD (OpenAI-compatible clinical-reasoning target) =====
# Separate from the manual OpenEvidence tool. Enabled only when EVIDENCEMD_API_KEY is set.
# Generate the key at evidencemd.ai -> Developers -> Dashboard -> API keys -> Create key.
EVIDENCEMD_API_KEY=
EVIDENCEMD_BASE_URL=https://evidencemd.ai/api/v1
TARGET_EVIDENCEMD_MODEL_ID=evidencemd-pro

# ===== Evidence ingestion from the UI (/evidence/ingest) =====
# The three corpus-growing routines (trials + network build, openFDA drug facts, offline
# re-parse) as background jobs, so growing the corpus no longer needs
# `docker exec -it evidence-monitoring-agent python -m scripts.ingest_evidence`.
# Preview (write nothing) is the default on every form.
#
# THIS FLAG IS THE ONLY GATE. There is no RBAC in this tree, so on a publicly reachable box
# anyone who loads the UI can spend the ClinicalTrials.gov / openFDA budget and write to the
# evidence corpus. Set false to force the CLI path. It cannot verify anything — verification
# stays one study at a time on /api/evidence-review/studies/{id}/curator-check — so the
# blast radius is unreviewed EXTRACTED/MAPPED rows and PROPOSED memberships.
EVIDENCE_INGESTION_API_ENABLED=true

# ===== Server (do not change; nginx proxies to this inside the container) =====
API_HOST=0.0.0.0
API_PORT=8000
